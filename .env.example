# Copy this file to .env for local development:  cp .env.example .env
# .env is ignored by git. Never put real secrets in this example file.

# True for local development ONLY. If this is missing, FitHub starts in safe production mode
# (secure cookies, HTTPS redirect) and refuses to start without a secret key.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is not True. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=

# Production only (DJANGO_DEBUG=False)
# DJANGO_ALLOWED_HOSTS=links.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://links.example.com
# DJANGO_ADMIN_URL=a-long-unguessable-path/
# DATABASE_URL=postgres://user:password@host:5432/fithub
# Number of reverse proxies in front of the app (Render, Railway, nginx = 1). Needed so HTTPS
# detection and per-visitor rate limits use the real visitor address. Leave 0 with no proxy.
# DJANGO_TRUSTED_PROXY_COUNT=1
# DJANGO_HSTS_SECONDS=3600            # raise to 31536000 once HTTPS works everywhere
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# DJANGO_TIME_ZONE=Asia/Kathmandu
