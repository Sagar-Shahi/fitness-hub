# Copy this file to `.env` and fill in real values. `.env` is ignored by git, so it never gets committed.
#   cp .env.example .env            (Windows PowerShell: Copy-Item .env.example .env)
#
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# Required when DJANGO_DEBUG=False. In development a clearly marked insecure key is used if this is empty.
DJANGO_SECRET_KEY=

# Leave True for local development. Set to False in production.
DJANGO_DEBUG=True

# Comma separated list of hostnames the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed if you enable Stripe checkout (see README). Use a test-mode key (sk_test_...).
# STRIPE_SECRET_KEY=
